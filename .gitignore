# ============================================================
# BinWise - AI Waste Management Platform
# .gitignore - Files to exclude from Git
# ============================================================

# ── NODE MODULES ─────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── PRODUCTION BUILDS ────────────────────────────────────────
client/dist/
client/build/

# ── ENVIRONMENT / SECRETS ────────────────────────────────────
.env
.env.local
.env.production
.env.development
server/.env
*.env

# ── AWS CREDENTIALS & SSH KEYS ───────────────────────────────
*.pem
*.key
.aws/
kabaad-key.pem

# ── PYTHON / AI MODEL ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
ENV/

# ── AI MODEL WEIGHTS (large binary files) ────────────────────
model/
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.bin
*.onnx
*.safetensors

# ── DATASET (large image folders) ────────────────────────────
DATASET/
dataset/
datasets/
data/
*.zip
*.tar
*.tar.gz
*.gz
app_deploy.tar.gz

# ── LOGS ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS FILES ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── EDITOR / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ── MISC ─────────────────────────────────────────────────────
*.tmp
*.temp
.cache/
.parcel-cache/
coverage/
.nyc_output/
